<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloItemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_background"
                android:textSize="16sp"
                tools:text="Refatorar código legado" />

            <TextView
                android:id="@+id/txtCategoriaItemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                tools:text="💻 Programação · Refatoração de código" />

            <TextView
                android:id="@+id/txtNivelCompatibilidadeItemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_background_muted"
                android:textSize="12sp"
                tools:text="Nível: intermediario · ChatGPT · Claude · GitHub Copilot" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFavoritoItemPrompt"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detalhe_favorito_desc"
            android:src="@drawable/ic_star_outline" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
