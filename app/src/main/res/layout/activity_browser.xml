<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!--
        Fase 24 — a barra superior com o nome "AI Brain" foi removida a pedido
        do usuário: o site da IA agora ocupa a tela inteira. Voltar/avançar no
        histórico é feito pelos gestos de navegação do próprio Android, e a
        barra de abas continua presente (item "Nova aba" fecha o navegador e
        volta ao catálogo). Ações adicionais (atualizar/compartilhar/abrir
        externo) ficam no menu de cada aba (Fase 21.6).
    -->

    <!--
        Fase 21.8 — barra de abas (Fase 21.6 integrada à tela): cada aba
        aberta troca o WebView exibido no container abaixo via
        BrowserTabManager.ativarNaTela, sem recriar nem recarregar página.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAbasBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_high"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_aba_navegador" />

    <FrameLayout
        android:id="@+id/containerWebViewBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
