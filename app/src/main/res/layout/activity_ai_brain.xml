<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollBrain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/brain_voltar_desc"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/brain_titulo"
                android:textColor="@color/on_background"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="@string/brain_hint_pergunta"
            app:boxBackgroundColor="@color/surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPergunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_background"
                android:imeOptions="actionSearch"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerguntar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/secondary"
                android:enabled="false"
                android:text="@string/brain_botao_perguntar"
                android:textColor="@color/on_primary" />

            <ProgressBar
                android:id="@+id/progressCarregandoCatalogo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:indeterminateTint="@color/secondary" />

        </LinearLayout>

        <!-- Fase 15.4 — Filtros rápidos: 4 grupos de chips combináveis (Acesso, Categoria, Idioma, Avaliação),
             100% locais sobre o catálogo já carregado, sem chamada de rede. -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltrosRapidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAcesso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="false" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategoriaBrain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="false" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupIdioma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="false" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAvaliacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="false" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Indicador da quantidade de filtros ativos. -->
        <LinearLayout
            android:id="@+id/rowFiltrosStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFiltrosAtivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textColor="@color/on_background_muted"
                android:textSize="12sp"
                tools:text="2 filtros ativos" />


        </LinearLayout>

        <!-- Fase 15.5 — resultado dos filtros rápidos: exibido no lugar do fluxo de
             pergunta enquanto ao menos um filtro estiver ativo, com atualização instantânea. -->
        <LinearLayout
            android:id="@+id/containerResultadoFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFiltrosVazio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:text="@string/brain_filtros_resultado_vazio"
                android:textColor="@color/on_background"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ia" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtCategoriaDetectada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:textColor="@color/secondary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Categoria detectada: 🎥 Vídeo" />

        <TextView
            android:id="@+id/txtSemResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/brain_sem_resultado"
            android:textColor="@color/on_background"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/brain_secao_melhor"
                android:textColor="@color/on_background"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMelhorVazio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/brain_melhor_vazio"
                android:textColor="@color/on_background"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMelhor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ia" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/brain_secao_segunda"
                android:textColor="@color/on_background"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSegundaVazio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/brain_segunda_vazio"
                android:textColor="@color/on_background"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSegunda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ia" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/brain_secao_gratuitas"
                android:textColor="@color/on_background"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGratuitasVazio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/brain_gratuitas_vazio"
                android:textColor="@color/on_background"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGratuitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ia" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
