<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/btnVoltarCriadorPrompts"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/criador_prompts_voltar_desc"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloCriadorPrompts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:text="@string/criador_prompts_titulo"
        android:textColor="@color/on_background"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltarCriadorPrompts"
        app:layout_constraintStart_toEndOf="@id/btnVoltarCriadorPrompts"
        app:layout_constraintTop_toTopOf="@id/btnVoltarCriadorPrompts" />

    <!-- Histórico da sessão (Fase 17.2) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerConversa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltarCriadorPrompts"
        app:layout_constraintBottom_toTopOf="@id/containerAcoesResultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_mensagem_assistente" />

    <TextView
        android:id="@+id/txtConversaVazia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="@string/criador_prompts_conversa_vazia"
        android:textColor="@color/on_background_muted"
        app:layout_constraintTop_toTopOf="@id/recyclerConversa"
        app:layout_constraintBottom_toBottomOf="@id/recyclerConversa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ações do resultado final (Fase 17.18): visível só quando a sessão chega a PROMPT_ENTREGUE -->
    <LinearLayout
        android:id="@+id/containerAcoesResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/containerEntradaConversa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerSalvarPrompt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/criador_prompts_botao_ver_salvar"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirIARecomendada"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/criador_prompts_botao_abrir_ia"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Campo de mensagem + botão "Gerar prompt" (Fase 17.2) -->
    <LinearLayout
        android:id="@+id/containerEntradaConversa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/criador_prompts_hint_mensagem"
            app:boxBackgroundColor="@color/surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMensagemConversa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textCapSentences"
                android:maxLines="4"
                android:textColor="@color/on_background" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGerarPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/secondary"
            android:enabled="false"
            android:text="@string/criador_prompts_botao_gerar"
            android:textColor="@color/on_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
