<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="@dimen/space_sm"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/shape_medium"
    app:cardElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgLogoItem"
            android:layout_width="@dimen/list_icon_size"
            android:layout_height="@dimen/list_icon_size"
            android:background="@drawable/bg_logo_rounded"
            android:padding="@dimen/space_sm"
            android:contentDescription="@string/detalhe_logo_desc"
            android:src="@drawable/ic_image_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_background"
                style="@style/TextAppearance.AIBrain.TituloSecao"
                tools:text="ChatGPT" />

            <TextView
                android:id="@+id/txtDescricaoItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_background_muted"
                style="@style/TextAppearance.AIBrain.Corpo"
                tools:text="Assistente de IA conversacional. Ótimo para conversas, código e escrita." />

            <TextView
                android:id="@+id/txtCategoriasItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                tools:text="💬 Conversa · 💻 Código" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFavoritoItem"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="@dimen/space_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detalhe_favorito_desc"
            android:src="@drawable/ic_star_outline" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
