<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnVoltarComparacao"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/brain_voltar_desc"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/brain_comparacao_titulo"
                style="@style/TextAppearance.AIBrain.TituloTela" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtComparacaoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:textColor="@color/secondary"
            style="@style/TextAppearance.AIBrain.TituloSecao"
            tools:text="Comparando para: Código" />

        <TextView
            android:id="@+id/txtComparacaoAjuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/brain_comparacao_ajuda"
            android:textColor="@color/on_background_muted"
            style="@style/TextAppearance.AIBrain.Legenda" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/tabelaComparacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:stretchColumns="*"
                android:shrinkColumns="*" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
