<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_loading">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/imgLoadingLogo"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:contentDescription="@string/loading_logo_desc"
            android:scaleType="centerInside"
            android:src="@drawable/ic_logo"
            app:layout_constraintBottom_toTopOf="@id/txtLoadingNome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.38"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/txtLoadingNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/app_name"
            style="@style/TextAppearance.AIBrain.Display"
            android:textColor="@color/brand_on_dark"
            app:layout_constraintBottom_toTopOf="@id/txtLoadingMensagem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLoadingLogo" />

        <TextView
            android:id="@+id/txtLoadingMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/loading_mensagem"
            style="@style/TextAppearance.AIBrain.Corpo"
            android:textColor="@color/brand_on_dark_muted"
            app:layout_constraintBottom_toTopOf="@id/progressLoading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLoadingNome" />

        <ProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="148dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_lg"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_cyan"
            android:indeterminateTintMode="src_in"
            android:max="100"
            android:progress="0"
            app:layout_constraintBottom_toTopOf="@id/txtLoadingStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLoadingMensagem" />

        <TextView
            android:id="@+id/txtLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/loading_status"
            style="@style/TextAppearance.AIBrain.Legenda"
            android:textColor="@color/brand_on_dark_muted"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressLoading" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/welcomeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgWelcomeLogo"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:contentDescription="@string/loading_logo_desc"
            android:scaleType="centerInside"
            android:src="@drawable/ic_logo"
            app:layout_constraintBottom_toTopOf="@id/txtWelcomeNome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.28"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/txtWelcomeNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/app_name"
            style="@style/TextAppearance.AIBrain.Display"
            android:textColor="@color/on_background"
            app:layout_constraintBottom_toTopOf="@id/txtWelcomeMensagem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgWelcomeLogo" />

        <TextView
            android:id="@+id/txtWelcomeMensagem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_md"
            android:gravity="center"
            android:text="@string/welcome_mensagem"
            style="@style/TextAppearance.AIBrain.Corpo"
            android:textColor="@color/on_background_muted"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtWelcomeNome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrar"
            style="@style/Widget.AIBrain.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_2xl"
            android:backgroundTint="@color/secondary"
            android:text="@string/welcome_botao_entrar"
            android:textColor="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
