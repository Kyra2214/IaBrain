<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/space_md">

            <ImageButton
                android:id="@+id/btnVoltarDetalhe"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/brain_voltar_desc"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/brain_detalhe_titulo"
                style="@style/TextAppearance.AIBrain.TituloTela" />

            <ImageButton
                android:id="@+id/btnFavorito"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detalhe_favorito_desc"
                android:src="@drawable/ic_star_outline" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/shape_medium"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_logo_rounded"
                    android:contentDescription="@string/detalhe_logo_desc"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_image_placeholder" />

                <TextView
                    android:id="@+id/txtNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/on_surface"
                    style="@style/TextAppearance.AIBrain.TituloTela"
                    tools:text="Claude" />

                <TextView
                    android:id="@+id/txtTipoAcesso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/secondary"
                    style="@style/TextAppearance.AIBrain.Status"
                    tools:text="🟡 Freemium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/on_background"
            style="@style/TextAppearance.AIBrain.Corpo"
            tools:text="Assistente de IA para programação e análise de documentos." />

        <TextView
            android:id="@+id/txtPorqueUsar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/on_background"
            style="@style/TextAppearance.AIBrain.TituloSecao"
            tools:text="Por que usar?" />

        <TextView
            android:id="@+id/txtPorqueUsarConteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/on_background_muted"
            style="@style/TextAppearance.AIBrain.Corpo"
            tools:text="Nota cadastrada em Código: 10/10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalhe_especialidades_titulo"
            style="@style/TextAppearance.AIBrain.TituloSecao" />

        <TextView
            android:id="@+id/txtCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/secondary"
            style="@style/TextAppearance.AIBrain.Corpo"
            tools:text="💻 Código · ✍️ Escrita" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalhe_capacidades_titulo"
            style="@style/TextAppearance.AIBrain.TituloSecao" />

        <TextView
            android:id="@+id/txtCapacidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/on_background"
            style="@style/TextAppearance.AIBrain.Corpo"
            tools:text="✓ Código · ✓ Análise" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalhe_idiomas_titulo"
            style="@style/TextAppearance.AIBrain.TituloSecao" />

        <TextView
            android:id="@+id/txtIdiomas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/on_background"
            style="@style/TextAppearance.AIBrain.Corpo"
            tools:text="PT · EN · ES" />

        <TextView
            android:id="@+id/txtCasosDeUso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/on_background_muted"
            style="@style/TextAppearance.AIBrain.Legenda"
            tools:text="Casos de uso: projetos técnicos" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalhe_notas_titulo"
            style="@style/TextAppearance.AIBrain.TituloSecao" />

        <LinearLayout
            android:id="@+id/containerNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirIA"
                style="@style/Widget.AIBrain.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_botao_abrir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComparar"
                style="@style/Widget.AIBrain.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_botao_comparar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarPrompt"
                style="@style/Widget.AIBrain.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_botao_prompt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerguntarChat"
                style="@style/Widget.AIBrain.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_botao_chat" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
