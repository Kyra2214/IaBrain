<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAbaItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_xs"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs"
    app:cardBackgroundColor="@color/primary_variant"
    app:cardCornerRadius="@dimen/shape_small"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <ImageView
            android:id="@+id/imgAbaItem"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_image_placeholder" />

        <ImageView
            android:id="@+id/imgAbaFixada"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/browser_aba_fixada_desc"
            android:src="@drawable/ic_pin"
            android:visibility="gone"
            app:tint="@color/on_primary" />

        <TextView
            android:id="@+id/txtAbaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxWidth="96dp"
            android:maxLines="1"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            tools:text="ChatGPT" />

        <ProgressBar
            android:id="@+id/progressAbaItem"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/space_xs"
            android:indeterminateTint="@color/on_primary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnFecharAbaItem"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_fechar_aba_desc"
            android:src="@drawable/ic_close"
            app:tint="@color/on_primary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
